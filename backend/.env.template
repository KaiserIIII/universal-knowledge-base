# ═══════════════════════════════════════════════
# 通用知识库 — 环境变量配置模板 (零依赖版)
# 复制此文件为 .env 并填写实际值
# ═══════════════════════════════════════════════

# ── 数据库 (SQLite) ──────────────────────────
DATABASE_URL=sqlite+aiosqlite:///data/knowledge_base.db

# ── ChromaDB 向量库路径 ───────────────────────
CHROMA_PERSIST_DIR=data/chroma_db

# ── 本地 Embedding 模型 ───────────────────────
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ── 本地 Reranker (默认关闭, 吃内存) ──────────
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
USE_RERANKER=false

# ── 大模型 API (DeepSeek / 任意 OpenAI 兼容) ─
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_MODEL=deepseek-chat

# ── 文档处理 ──────────────────────────────────
CHUNK_DEFAULT_SIZE=1000
CHUNK_DEFAULT_OVERLAP=200

# ── 搜索默认值 ────────────────────────────────
SEARCH_DEFAULT_TOP_K=5
SEARCH_DEFAULT_ALPHA=0.5
SEARCH_DEFAULT_THRESHOLD=0.4

# ── 高精度文档解析（失败时自动回退至轻量解析器）───────────
USE_UNSTRUCTURED=true

# ── 应用 ─────────────────────────────────────
APP_NAME=通用知识库
DEBUG=false
