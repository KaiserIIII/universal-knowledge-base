# 知序 Enterprise Knowledge — 复制为 backend/.env，填写部署配置。
# 本模板用于本机 HTTP；公网 HTTPS 部署必须启用 COOKIE_SECURE。
APP_NAME=知序 Enterprise Knowledge
PUBLIC_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
DEBUG=false

# 相对路径以 backend/app 为基准。升级默认使用独立 SaaS 存储。
DATABASE_URL=sqlite+aiosqlite:///data/saas/knowledge.db
CHROMA_PERSIST_DIR=data/saas/chroma
UPLOAD_TEMP_DIR=data/saas/uploads
# DATABASE_URL=postgresql+asyncpg://enterprise_kb:PASSWORD@localhost:5432/enterprise_kb

# Embedding 属于部署级配置；更换维度必须建立新索引并计划迁移。
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
USE_RERANKER=false
BM25_K1=1.5
BM25_B=0.75
CHUNK_DEFAULT_SIZE=1000
CHUNK_DEFAULT_OVERLAP=200
USE_UNSTRUCTURED=false
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_BATCH=20
SEARCH_DEFAULT_TOP_K=5
SEARCH_DEFAULT_ALPHA=0.5
SEARCH_DEFAULT_THRESHOLD=0.4

# 默认 OpenAI 兼容模型；密钥留空时返回可处理的未配置错误。
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 模型配置只引用部署者明确允许的进程环境变量，不保存密钥。
MODEL_ALLOWED_HOSTS=["api.openai.com","api.deepseek.com"]
MODEL_ALLOWED_SECRET_REFS=["SUPPORT_MODEL_API_KEY"]
# SUPPORT_MODEL_API_KEY 必须注入服务进程环境；仅写在 backend/.env 不会导出该值。
# Docker Compose 使用根目录 .env，并显式把该变量传给 app 容器。
MODEL_PRIVATE_HOSTS=[]
MODEL_ALLOW_HTTP=false
WORKFLOW_TIMEOUT_SECONDS=180
WORKFLOW_OUTPUT_TOKEN_BUDGET=16384
WORKFLOW_LEASE_SECONDS=15

SESSION_TTL_SECONDS=28800
INVITE_TTL_SECONDS=172800
API_KEY_TTL_SECONDS=7776000
INGESTION_WORKER_ENABLED=true
INGESTION_MAX_ATTEMPTS=3
INGESTION_LEASE_SECONDS=60
INGESTION_POLL_SECONDS=2
INGESTION_JOB_TIMEOUT_SECONDS=900

# 未配置 Stripe 时保持 Free 配额；套餐不会根据前端跳转升级。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEAM_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
